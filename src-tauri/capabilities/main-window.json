{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Ventana principal: solo comandos propios habilitados explícitamente. Sin plugins shell/fs/http.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-settings",
    "allow-set-setting",
    "allow-get-store-status",
    "allow-recover-store",
    "allow-get-privilege-context",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-last-junk-scan",
    "allow-list-junk-findings",
    "allow-preview-cleanup",
    "allow-confirm-cleanup",
    "allow-cancel-cleanup",
    "allow-prepare-empty-recycle-bin",
    "allow-acknowledge-empty-recycle-bin",
    "allow-empty-recycle-bin",
    "allow-start-duplicate-scan",
    "allow-get-last-duplicate-scan",
    "allow-list-duplicate-groups",
    "allow-preview-duplicate-cleanup",
    "allow-confirm-duplicate-cleanup",
    "allow-start-folder-scan",
    "allow-get-last-folder-scan",
    "allow-list-folder-children",
    "allow-list-large-files",
    "allow-pick-folder-root",
    "allow-reveal-in-explorer",
    "allow-start-monitor-stream",
    "allow-stop-monitor-stream",
    "allow-list-cleanup-runs",
    "allow-list-cleanup-entries"
  ]
}
