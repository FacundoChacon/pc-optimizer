{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Ventana principal: solo comandos propios habilitados explícitamente. Sin plugins shell/fs/http.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-settings",
    "allow-set-setting",
    "allow-get-store-status",
    "allow-recover-store",
    "allow-get-privilege-context",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-last-junk-scan",
    "allow-list-junk-findings"
  ]
}
